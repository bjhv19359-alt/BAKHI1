local function clearList()
	for _,v in ipairs(Scroll:GetChildren()) do
		if v:IsA("TextButton") or v:IsA("Frame") then
			v:Destroy()
		end
	end
end

local function refreshList()
	clearList()

	for i,note in ipairs(NOTES) do
		local row=Instance.new("Frame")
		row.Size=UDim2.new(1,-3,0,30)
		row.BackgroundTransparency=1
		row.ClipsDescendants=true
		row.LayoutOrder=i
		row.Parent=Scroll

		local item=Instance.new("TextButton")
		item.Size=UDim2.new(1,-22,1,0)
		item.Position=UDim2.fromOffset(0,0)
		item.BackgroundColor3=Color3.fromRGB(38,38,48)
		item.BorderSizePixel=0
		item.Text=note.name or ("Script "..i)
		item.TextColor3=Color3.fromRGB(235,235,240)
		item.TextSize=9
		item.Font=Enum.Font.Gotham
		item.TextXAlignment=Enum.TextXAlignment.Left
		item.TextTruncate=Enum.TextTruncate.AtEnd
		item.ClipsDescendants=true
		item.AutoButtonColor=true
		item.Parent=row

		local pad=Instance.new("UIPadding")
		pad.PaddingLeft=UDim.new(0,6)
		pad.PaddingRight=UDim.new(0,3)
		pad.Parent=item

		local c=Instance.new("UICorner")
		c.CornerRadius=UDim.new(0,5)
		c.Parent=item

		local del=Instance.new("TextButton")
		del.Size=UDim2.fromOffset(20,30)
		del.Position=UDim2.new(1,-20,0,0)
		del.BackgroundColor3=Color3.fromRGB(50,32,38)
		del.BorderSizePixel=0
		del.Text="×"
		del.TextColor3=Color3.fromRGB(255,120,120)
		del.TextSize=13
		del.Font=Enum.Font.GothamBold
		del.AutoButtonColor=true
		del.Parent=row

		local dc=Instance.new("UICorner")
		dc.CornerRadius=UDim.new(0,5)
		dc.Parent=del

		item.MouseButton1Click:Connect(function()
			selectedIndex=i
			NameBox.Text=NOTES[i].name or ""
			CodeBox.Text=NOTES[i].code or ""
		end)

		del.MouseButton1Click:Connect(function()
			table.remove(NOTES,i)

			if selectedIndex==i then
				selectedIndex=nil
				NameBox.Text=""
				CodeBox.Text=""
			elseif selectedIndex and selectedIndex>i then
				selectedIndex-=1
			end

			refreshList()
		end)
	end
end

NewButton.MouseButton1Click:Connect(function()
	selectedIndex=nil
	NameBox.Text=""
	CodeBox.Text=""
end)

SaveButton.MouseButton1Click:Connect(function()
	local name=NameBox.Text
	local code=CodeBox.Text

	if name=="" then
		name="Script "..(#NOTES+1)
	end

	table.insert(NOTES,{
		name=name,
		code=code
	})

	selectedIndex=#NOTES
	refreshList()
end)

UpdateButton.MouseButton1Click:Connect(function()
	if not selectedIndex or not NOTES[selectedIndex] then
		return
	end

	local name=NameBox.Text
	if name=="" then
		name="Script "..selectedIndex
	end

	NOTES[selectedIndex].name=name
	NOTES[selectedIndex].code=CodeBox.Text

	refreshList()
end)

CopyButton.MouseButton1Click:Connect(function()
	if setclipboard then
		setclipboard(CodeBox.Text)
	end
end)

local function setSize(w,h)
	w=math.clamp(w,MIN_W,MAX_W)
	h=math.clamp(h,MIN_H,MAX_H)

	Main.Size=UDim2.fromOffset(w,h)

	if not minimized then
		lastW=w
		lastH=h
	end
end

local resizing=false
local resizeStart
local resizeSize

local Resize=Instance.new("TextButton")
Resize.Name="Resize"
Resize.Size=UDim2.fromOffset(20,20)
Resize.Position=UDim2.new(1,-20,1,-20)
Resize.BackgroundTransparency=1
Resize.Text="◢"
Resize.TextColor3=Color3.fromRGB(160,160,175)
Resize.TextSize=13
Resize.Font=Enum.Font.GothamBold
Resize.ZIndex=30
Resize.Parent=Main

Resize.InputBegan:Connect(function(input)
	if input.UserInputType~=Enum.UserInputType.Touch
		and input.UserInputType~=Enum.UserInputType.MouseButton1 then
		return
	end

	resizing=true
	resizeStart=input.Position
	resizeSize=Main.AbsoluteSize

	input.Changed:Connect(function()
		if input.UserInputState==Enum.UserInputState.End then
			resizing=false
		end
	end)
end)

UIS.InputChanged:Connect(function(input)
	if resizing then
		if input.UserInputType~=Enum.UserInputType.Touch
			and input.UserInputType~=Enum.UserInputType.MouseMovement then
			return
		end

		local delta=input.Position-resizeStart
		setSize(
			resizeSize.X+delta.X,
			resizeSize.Y+delta.Y
		)
	end
end)

local dragging=false
local dragStart
local startPos

DragBar.InputBegan:Connect(function(input)
	if input.UserInputType~=Enum.UserInputType.Touch
		and input.UserInputType~=Enum.UserInputType.MouseButton1 then
		return
	end

	dragging=true
	dragStart=input.Position
	startPos=Main.Position

	input.Changed:Connect(function()
		if input.UserInputState==Enum.UserInputState.End then
			dragging=false
		end
	end)
end)

UIS.InputChanged:Connect(function(input)
	if not dragging then
		return
	end

	if input.UserInputType~=Enum.UserInputType.Touch
		and input.UserInputType~=Enum.UserInputType.MouseMovement then
		return
	end

	local delta=input.Position-dragStart

	Main.Position=UDim2.new(
		startPos.X.Scale,
		startPos.X.Offset+delta.X,
		startPos.Y.Scale,
		startPos.Y.Offset+delta.Y
	)
end)

Collapse.MouseButton1Click:Connect(function()
	minimized=not minimized

	if minimized then
		lastW=Main.AbsoluteSize.X
		lastH=Main.AbsoluteSize.Y

		Main.Size=UDim2.fromOffset(lastW,MINI_H)

		ListPanel.Visible=false
		Editor.Visible=false
		Resize.Visible=false

		Collapse.Text="+"
	else
		Main.Size=UDim2.fromOffset(lastW,lastH)

		ListPanel.Visible=true
		Editor.Visible=true
		Resize.Visible=true

		Collapse.Text="-"
	end
end)

refreshList()
